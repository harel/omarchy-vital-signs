{
  "schemaVersion": 1,
  "id": "harel.vital-signs",
  "name": "Vital Signs",
  "version": "0.3.0",
  "author": "Harel",
  "license": "MIT",
  "description": "A compact Omarchy bar status line for RAM, load, and network download speed, with CPU, temperature, and fan details.",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Vital Signs",
    "description": "RAM, load, and download speed with a hardware details panel",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "visibleMetrics": ["ram", "load1", "download"],
      "iconMetrics": ["ram", "load1", "load5", "load15", "download", "upload", "cpu", "temperature", "fan", "battery"],
      "refreshSeconds": 2,
      "alignment": "right",
      "hideZeroValues": false
    }
  }
}
